{
  // The app that runs herdr. Picking an issue brings it to the front; "" leaves focus alone.
  "terminalBundleId": "com.googlecode.iterm2",

  // With no herdr window open, picking a tab opens a new iTerm window with herdr in it (iTerm only).
  "openHerdrWhenClosed": true,

  // A line in an idle agent's output that marks a plan waiting for your go, as a regular expression.
  "planPattern": "^\\s*(Single PR:|PR 1:)",

  // The issue page: a key for each action that fits the issue now, after the issue itself and before
  // "back". While the agent waits on you, the page shows its question instead: one key per choice, as
  // its screen shows them.
  // type "prompt":  the text plus Enter, to the issue's agent.
  // type "keys":    key presses for the issue's agent, space separated (enter, esc, ctrl+c).
  // type "shell":   a command run in the issue's worktree, with $ISSUE_CWD set.
  // type "open-pr": opens the issue's pull request in the browser; shown only while there is one.
  // icon: the key's icon by name, such as "play", "tool" or "commit"; the names are in plugin/src/Helpers/Icons.cs.
  // color: the circle behind the icon when the key lights up, as #RRGGBB (herdr's palette: #ff8080 red, #f36a1b accent).
  // when: the issue statuses in which the key lights up, so the action that fits stands out.
  // onlyWhen: the statuses in which the key shows; it is left off the page in the others. Without it, always.
  // Statuses: waiting, go?, CI failed, changes, done, ready, working, review, draft, idle, merged, closed.
  "actions": [
    { "label": "go", "type": "prompt", "value": "go", "color": "#f36a1b", "icon": "play", "when": ["go?"], "onlyWhen": ["go?", "idle", "done"] },
    { "label": "review\nand fix", "type": "prompt", "value": "/review-and-fix", "icon": "tool", "when": ["done"], "onlyWhen": ["done", "idle"] },
    { "label": "babysit\npr", "type": "prompt", "value": "/babysit-pr", "icon": "lifebuoy", "when": ["CI failed", "changes"], "onlyWhen": ["CI failed", "changes", "review", "draft"] },
    { "label": "commit", "type": "prompt", "value": "Commit the work in several logical commits, each with its own conventional-commit message.", "icon": "commit", "onlyWhen": ["done", "idle"] },
    { "label": "stop", "type": "keys", "value": "esc", "icon": "stop", "onlyWhen": ["working"] },
    { "label": "open PR", "type": "open-pr", "icon": "pull-request", "when": ["ready"] },
    { "label": "editor", "type": "shell", "value": "\"$HOME/.local/bin/hopen\" \"$ISSUE_CWD\"", "icon": "code" }
  ]
}
