{
  // The app that runs herdr. Picking a ticket brings it to the front; "" leaves focus alone.
  "terminalBundleId": "com.googlecode.iterm2",

  // With no herdr window open, picking a tab opens a new iTerm window with herdr in it (iTerm only).
  "openHerdrWhenClosed": true,

  // The ticket page: one key per action, after the ticket itself and before "terug".
  // type "prompt": the text plus Enter, to the ticket's agent.
  // type "keys":   key presses for the ticket's agent, space separated (enter, esc, ctrl+c).
  // type "shell":  a command run in the ticket's worktree, with $TICKET_CWD set.
  // color: the stripe on top of the key, as #RRGGBB.
  "actions": [
    { "label": "go", "type": "prompt", "value": "go", "color": "#FF8A3D" },
    { "label": "toestaan", "type": "keys", "value": "enter", "color": "#E5484D" },
    { "label": "review\nand fix", "type": "prompt", "value": "/review-and-fix" },
    { "label": "code\nreview", "type": "prompt", "value": "/code-review" },
    { "label": "commit", "type": "prompt", "value": "Commit the work in several logical commits, each with its own conventional-commit message." },
    { "label": "stop", "type": "keys", "value": "esc" },
    { "label": "editor", "type": "shell", "value": "\"$HOME/.local/bin/hopen\" \"$TICKET_CWD\"" }
  ]
}
